{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "lint": "eslint .",
    "test:unit": "jest --config tests/jestConfig/jest.config.unit.js",
    "test:integration": "jest --config tests/jestConfig/jest.config.integration.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:ci": "jest --config tests/jestConfig/jest.config.unit.js --ci --reporters=default --reporters=jest-junit && jest --config tests/jestConfig/jest.config.integration.js --ci --reporters=default --reporters=jest-junit"
  },
  "author": "Subha Mal",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "jest-junit": "^17.0.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.2.2"
  },
  "dependencies": {
    "aws-sdk": "^2.1596.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.2.4",
    "node-localstorage": "^3.0.5",
    "razorpay": "^2.9.3"
  },
  "jest-junit": {
  "outputDirectory": "./test-results",
  "outputName": "junit.xml",
  "uniqueOutputName": "true",
  "classNameTemplate": "{classname}",
  "titleTemplate": "{title}"
}
}
